{
  "name": "autodisco",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@12.8.2",
  "description": "Automatically generate OpenAPI schemas by probing RESTful APIs",
  "author": "Frederik Bußmann <frederik@bussmann.io>",
  "license": "MIT",
  "repository": "bussmann-io/autodisco",
  "keywords": [
    "codegen",
    "openapi",
    "zod",
    "typescript",
    "api",
    "discovery",
    "rest",
    "schema",
    "generation"
  ],
  "exports": {
    ".": "./dist/index.mjs"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "discover": "dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "build:test": "obuild && node dist/index.mjs",
    "dev": "vitest dev",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:cleanup": "rm -r ./test/.outputs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "dependencies": {
    "c12": "^4.0.0-rc.2",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "hookable": "^6.1.2",
    "jiti": "^2.7.0",
    "ufo": "^1.6.4",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "knip": "^6.39.0",
    "obuild": "^0.4.43",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
